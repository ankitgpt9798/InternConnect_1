# DEVELOPMENT settings. Copy this file to backend/.env and fill in the values. Never commit backend/.env.
# Production (Render) does not use this file: its settings are entered in the Render dashboard (see render.yaml and
# "Deploy on Render" in the README). The tests set their own values (backend/test/helpers/testServer.js).

# --- Server ---
NODE_ENV=development
PORT=5000
# Address of the React app (allowed by CORS)
CLIENT_URL=http://localhost:5173

# --- Database ---
# MongoDB Atlas > Connect > Drivers. Put the database name after the host.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/internconnect_new?retryWrites=true&w=majority
# Optional: set only if Node cannot resolve the mongodb+srv:// address on your network
# DNS_SERVERS=8.8.8.8,1.1.1.1

# --- Login security (Module 6) ---
# Proxies allowed to report the client's IP address (X-Forwarded-For). Leave empty locally (only the Vite dev
# server on this computer is trusted). In production set the number of proxies in front of the API, e.g. 1.
# TRUST_PROXY=
# Offline MaxMind GeoLite2 City database for approximate sign-in locations (see README). Default:
# backend/data/GeoLite2-City.mmdb. Without it, locations show as "Unknown".
# GEOIP_DB_PATH=
# Local testing only (ignored when NODE_ENV=production):
#   force the phone/tablet sign-in window (normally 10:00 AM-1:00 PM IST) open or closed
# MOBILE_LOGIN_WINDOW_TEST=open
#   end phone/tablet sessions this many minutes after sign-in (normally at 1:00 PM IST)
# MOBILE_SESSION_TEST_MINUTES=2

# --- Email: Mailtrap Email Testing sandbox (OTP codes, new passwords, invoices) ---
# Development and testing only: nothing is delivered to real inboxes.
MAILTRAP_USER=
MAILTRAP_PASS=
# Production uses Brevo SMTP instead (set in the Render dashboard, not here). If SMTP_HOST is set, it replaces Mailtrap:
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=InternConnect <no-reply@your-domain.com>

# --- Razorpay Test Mode (plan and resume payments). Only rzp_test_ keys are accepted. ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Plan payments are allowed only from 5:00 to 11:45 AM IST. For local testing at other times, set this to true.
# It is ignored when NODE_ENV=production.
# PAYMENT_WINDOW_TEST_OPEN=true

# --- Cloudinary (photos and videos in Public Space posts) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
